# Copy to .env for local development. Values already present in the environment win over this file.
# This file enables DEV_MODE and ships a known administrator password: it is for a developer
# machine only. A deployment sets DEV_MODE=false, its own ADMIN_PASSWORD and pre-generated keys.

SERVER_PORT=8080
SERVER_READ_TIMEOUT=15s
SERVER_WRITE_TIMEOUT=15s
SERVER_SHUTDOWN_TIMEOUT=10s

LOG_LEVEL=info          # debug | info | warn | error
LOG_FORMAT=json         # json | text

DB_HOST=localhost
DB_PORT=5432
DB_USER=iam_user
DB_PASSWORD=iam_password
DB_NAME=iam_db
DB_SSLMODE=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_MIGRATE=true

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# RSA key pair for RS256. With DEV_MODE=true missing keys are generated on first start.
JWT_PRIVATE_KEY_PATH=configs/keys/private.pem
JWT_PUBLIC_KEY_PATH=configs/keys/public.pem
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_TOKEN_TTL=168h
# Longest a session may live however often it is refreshed; 0 removes the bound.
JWT_SESSION_MAX_AGE=720h
JWT_ISSUER=iam-service

# Generates missing RSA keys and allows the default administrator password. Never in production.
DEV_MODE=true

# First administrator, created on start if missing; an existing account is granted the admin
# role. Outside DEV_MODE the password is required and must satisfy the password policy; an
# empty ADMIN_EMAIL skips seeding.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin123!

CASBIN_MODEL_PATH=configs/casbin_model.conf
AUTHZ_WATCHER_ENABLED=false

LOCKOUT_MAX_ATTEMPTS=5
LOCKOUT_DURATION=15m
PASSWORD_MAX_AGE=2160h   # 90 days; 0 disables expiry

RATE_LIMIT_RPS=100
RATE_LIMIT_BURST=200
LOGIN_RATE_LIMIT_PER_MIN=5
LOGIN_RATE_LIMIT_BURST=10

# Comma-separated origins with scheme, e.g. https://app.example.com; "*" allows any origin
# without credentials. Empty disables CORS handling.
CORS_ALLOWED_ORIGINS=
# Comma-separated proxy addresses or CIDRs whose X-Forwarded-For is trusted.
TRUSTED_PROXIES=

OTEL_ENABLED=false
OTEL_ENDPOINT=localhost:4317
OTEL_SERVICE_NAME=iam-service
OTEL_ENVIRONMENT=development
